# Environment Configuration for FairMed Backend
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application Security
# Generate a secret using: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=fairmed_secret_development_key_change_in_production_89af3b7c4d
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / Supabase)
# For local fallback development: sqlite:///./fairmed.db
# For Supabase PostgreSQL production: postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./fairmed.db

# Supabase Credentials (Optional for direct PostgreSQL, required for Supabase Auth/Storage)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Storage Directories
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports

# OCR Configuration
OCR_ENGINE=hybrid  # Options: hybrid, pypdf, paddleocr
MAX_FILE_SIZE_MB=25
